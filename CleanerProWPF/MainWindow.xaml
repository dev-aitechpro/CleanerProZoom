<Window x:Class="CleanerProWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cleaner Pro"
        Height="850" 
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="False"
        Icon="pack://application:,,,/Resources/icon.ico">

    <Window.Resources>
        <Storyboard x:Key="ButtonScaleUp">
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                           To="1.04" Duration="0:0:0.12" DecelerationRatio="0.7"/>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                           To="1.04" Duration="0:0:0.12" DecelerationRatio="0.7"/>
        </Storyboard>
        <Storyboard x:Key="ButtonScaleDown">
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                           To="1" Duration="0:0:0.12" DecelerationRatio="0.7"/>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                           To="1" Duration="0:0:0.12" DecelerationRatio="0.7"/>
        </Storyboard>
    </Window.Resources>

    <Border Background="#0b1017" CornerRadius="20" BorderBrush="#1c2538" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель с кнопками управления окном -->
            <Border Grid.Row="0" Background="#121924" CornerRadius="20,20,0,0" 
                    MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- ИКОНКА ПРОГРАММЫ В ЛЕВОМ УГЛУ -->

                    <!-- Кнопки управления окном -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Button Content="─" Click="MinimizeWindow_Click" 
                                Background="Transparent" Foreground="#8a94a6" 
                                FontSize="18" Width="36" Height="36" Cursor="Hand" BorderThickness="0"/>
                        <Button Content="✕" Click="CloseWindow_Click" 
                                Background="Transparent" Foreground="#8a94a6" 
                                FontSize="16" Width="36" Height="36" Cursor="Hand" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Основной контент -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar с логотипом -->
                <Border Grid.Column="0" Background="#121924" BorderBrush="#2a3346" BorderThickness="0,0,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20,16,16,20">
                            <!-- ЛОГОТИП – ЗДЕСЬ МЕНЯЕМ ЭМОДЗИ НА ИКОНКУ -->
                            <Border Background="#0b1017" CornerRadius="12" Padding="16,14" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <!-- Вместо TextBlock с метлой ставим Image с иконкой -->
                                    <Image Source="pack://application:,,,/Resources/icon.ico"
                                           Margin="0,0,12,0" Width="48"/>
                                    <StackPanel>
                                        <TextBlock Text="CLEANER PRO" FontSize="18" FontWeight="Bold" Foreground="White" Width="124"/>
                                        <TextBlock Text="by Pavel Daily" FontSize="11" Foreground="#8a94a6" Margin="0,-2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel>
                                <Border Background="#1a2744" BorderBrush="#2f6bff" BorderThickness="3,0,0,0" CornerRadius="12" Padding="12,16">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🖥️" Margin="0,0,14,0" FontSize="16"/>
                                        <TextBlock Text="Очистка Windows" FontSize="14" Foreground="White" FontWeight="Medium"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- СТАТУС СИСТЕМЫ -->
                            <Border Margin="0,16,0,12" Background="#111924" BorderBrush="#2a3346" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel x:Name="SystemStatusBox">
                                    <TextBlock Text="Состояние системы" FontSize="12" Foreground="#8a94a6"/>
                                    <TextBlock Margin="0,2,0,0" FontSize="18" FontWeight="Bold" Foreground="#2ab674">
                                        <Run Text="🛡️ "/><Run Text="Отлично"/>
                                    </TextBlock>
                                    <TextBlock Text="Система чиста и оптимизирована" FontSize="11" Foreground="#8a94a6"/>
                                </StackPanel>
                            </Border>

                            <!-- Социальные сети -->
                            <WrapPanel>
                                <Button Content="Telegram" Style="{StaticResource SocialButtonStyle}" Margin="0,0,6,6" Click="SocialButton_Click" Tag="https://t.me/dev_aitech"/>
                                <Button Content="Поддержать" Style="{StaticResource SocialButtonStyle}" Margin="0,0,6,6" Click="SocialButton_Click" Tag="https://boosty.to/kpavels1997/donate"/>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Main Content -->
                <Grid Grid.Column="1" Background="#0b1017">
                    <Grid Margin="28,24,28,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Заголовок -->
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" FontSize="24" FontWeight="SemiBold" Foreground="White">
                                <Run Text="Очистка Windows"/>
                            </TextBlock>

                            <TextBlock Grid.Column="1" FontSize="14" Foreground="#8a94a6" 
                                       VerticalAlignment="Center" Margin="16,0,0,0">
                                Выберите категории для анализа и очистки системы
                            </TextBlock>

                            <Border Grid.Column="2" Background="#171f2e" 
                                    BorderBrush="#2a3346" BorderThickness="1" CornerRadius="12" Padding="16,8">
                                <StackPanel>
                                    <TextBlock x:Name="SelectedCount" Text="9 из 9" FontSize="18" FontWeight="Bold" 
                                               Foreground="#2f6bff" HorizontalAlignment="Center"/>
                                    <TextBlock Text="категорий выбрано" FontSize="12" Foreground="#8a94a6" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Список задач -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="TasksPanel" Margin="0,0,4,0"/>
                        </ScrollViewer>

                        <!-- Информация о размере -->
                        <Border Grid.Row="2" Background="#0a0e14" BorderBrush="#2a3346" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,12,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TotalSizeText" Text="Всего: 0 МБ" FontSize="12" Foreground="#8a94a6"/>
                            </StackPanel>
                        </Border>

                        <!-- Футер с кнопками -->
                        <Grid Grid.Row="3" Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#1a2744" CornerRadius="50" Padding="12" Margin="0,0,16,0">
                                <TextBlock Text="🔍" FontSize="20" Foreground="#2f6bff"/>
                            </Border>

                            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock Text="Нажмите «АНАЛИЗ» для поиска ненужных файлов" 
                                           FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Программа выполнит сканирование и покажет размер файлов для удаления" 
                                           FontSize="12" Foreground="#8a94a6"/>
                            </StackPanel>

                            <Button Grid.Column="2" x:Name="AnalyzeBtn" 
                                    Margin="0,0,12,0"
                                    Click="AnalyzeBtn_Click"
                                    Background="#1e2a44"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Padding="24,12"
                                    RenderTransformOrigin="0.5,0.5">
                                <Button.RenderTransform>
                                    <ScaleTransform/>
                                </Button.RenderTransform>
                                <Button.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard Storyboard="{StaticResource ButtonScaleUp}"/>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard Storyboard="{StaticResource ButtonScaleDown}"/>
                                    </EventTrigger>
                                </Button.Triggers>
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="12"/>
                                    </Style>
                                </Button.Resources>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#1e2a44"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="12"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#1e2a44"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <Button.Content>
                                    <TextBlock x:Name="AnalyzeBtnText" Text="🔍 АНАЛИЗ" Foreground="#2f6bff" FontSize="14" FontWeight="SemiBold"/>
                                </Button.Content>
                            </Button>

                            <Button Grid.Column="3" x:Name="CleanBtn" 
                                    Click="CleanBtn_Click"
                                    Background="#2ab674"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Padding="24,12"
                                    RenderTransformOrigin="0.5,0.5">
                                <Button.RenderTransform>
                                    <ScaleTransform/>
                                </Button.RenderTransform>
                                <Button.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard Storyboard="{StaticResource ButtonScaleUp}"/>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard Storyboard="{StaticResource ButtonScaleDown}"/>
                                    </EventTrigger>
                                </Button.Triggers>
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="12"/>
                                    </Style>
                                </Button.Resources>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#2ab674"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="12"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#2ab674"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <Button.Content>
                                    <TextBlock x:Name="CleanBtnText" Text="🧹 ОЧИСТИТЬ" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                </Button.Content>
                            </Button>
                        </Grid>

                        <!-- Копирайт -->
                        <TextBlock Grid.Row="3" Text="© 2026 Нейрокод | Neuralis (Dev_Ai Tech). Все права защищены." 
                                   HorizontalAlignment="Center" FontSize="11" Foreground="#8a94a6" 
                                   Opacity="0.5" Margin="0,53,0,-16"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>